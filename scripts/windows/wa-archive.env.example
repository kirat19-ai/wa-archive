REM Copy this file to wa-archive.env (same folder) and edit.
REM wa-archive.env is gitignored — it holds your local secrets.

REM Pin the admin password (otherwise a random one is generated on first run):
WA_ADMIN_PASSWORD=change-me-admin

REM Use the REAL WhatsApp connection (scan QR in the UI). Omit for mock/demo data:
REM WA_REAL=1

REM Bind address: 0.0.0.0 exposes the archive to phones on your Wi-Fi (LAN ON).
REM Use 127.0.0.1 to keep it to this PC only (LAN OFF).
HOST=0.0.0.0
PORT=8787
